    <string>export</string>
    <key>teamID</key>
    <string>REPLACE_TEAM_ID</string>
    <key>provisioningProfiles</key>
    <dict>
        <key>com.pediatricclinical.app</key>
        <string>REPLACE_PROFILE_UUID</string>
    </dict>
