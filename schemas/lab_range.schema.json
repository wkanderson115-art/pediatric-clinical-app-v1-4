{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "化验年龄分层参考区间",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "unit", "interpretation_type", "ranges", "method_note", "verified"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string"},
          "interpretation_type": {"type": "string", "enum": ["numeric", "qualitative"]},
          "ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["band", "low", "high"],
              "properties": {
                "band": {"type": "string"},
                "low": {"type": "number"},
                "high": {"type": "number"},
                "note": {"type": "string"}
              }
            }
          },
          "method_note": {"type": "string", "minLength": 10},
          "verified": {"type": "boolean", "const": false}
        }
      }
    }
  }
}
