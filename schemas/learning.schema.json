{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "学习专题",
  "type": "object",
  "required": ["systems"],
  "properties": {
    "systems": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "required": ["name", "topics"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "keywords", "content", "sources", "review_status"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z]+-\\d{2}$"},
                "title": {"type": "string", "minLength": 2},
                "keywords": {"type": "string"},
                "content": {
                  "type": "object",
                  "required": ["临床识别", "检查与鉴别", "处理与用药原则", "紧急警示", "常见误区"],
                  "properties": {
                    "临床识别": {"type": "string", "minLength": 4},
                    "检查与鉴别": {"type": "string", "minLength": 4},
                    "处理与用药原则": {"type": "string", "minLength": 4},
                    "紧急警示": {"type": "string", "minLength": 4},
                    "常见误区": {"type": "string", "minLength": 4}
                  }
                },
                "sources": {"type": "array"},
                "review_status": {"type": "string", "minLength": 8}
              }
            }
          }
        }
      }
    }
  }
}
