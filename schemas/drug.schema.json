{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "离线药典条目",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "generic_name", "category", "drug_class", "forms", "indications",
                     "peds_notes", "dose_note", "max_single", "renal_note", "hepatic_note",
                     "cautions", "contraindications", "adverse", "monitoring", "age_limit",
                     "interactions", "review_status", "tags", "aliases", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "generic_name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "category": {"type": "string", "minLength": 2},
          "drug_class": {"type": "string", "minLength": 2},
          "forms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "indications": {"type": "string", "minLength": 8},
          "peds_notes": {"type": "string", "minLength": 20},
          "dose_note": {"type": "string", "minLength": 20},
          "max_single": {"type": "string", "minLength": 4},
          "renal_note": {"type": "string"},
          "hepatic_note": {"type": "string"},
          "cautions": {"type": "string"},
          "contraindications": {"type": "string"},
          "adverse": {"type": "string"},
          "monitoring": {"type": "string"},
          "age_limit": {"type": "string"},
          "interactions": {"type": "string"},
          "sources": {"type": "array"},
          "review_status": {"type": "string", "minLength": 8},
          "tags": {"type": "array", "minItems": 1, "maxItems": 8}
        }
      }
    }
  }
}
