{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "跨模块关联索引",
  "type": "object",
  "required": ["index", "counts", "policy"],
  "properties": {
    "policy": {"type": "string", "minLength": 10},
    "counts": {"type": "object"},
    "index": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type", "id", "label", "basis"],
          "properties": {
            "type": {"type": "string", "enum": ["drug", "path", "lab", "exam", "topic", "quiz", "case"]},
            "id": {"type": "string", "minLength": 1},
            "label": {"type": "string", "minLength": 1},
            "basis": {"type": "string", "minLength": 4}
          }
        }
      }
    }
  }
}
