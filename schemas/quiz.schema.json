{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "循证练习题",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "stem", "choices", "correct", "explanation", "source_ids", "review_status"],
        "properties": {
          "id": {"type": "string", "pattern": "^cnq-\\d{3}$"},
          "category": {"type": "string"},
          "title": {"type": "string", "minLength": 2},
          "stem": {"type": "string", "minLength": 8},
          "choices": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 2}},
          "correct": {"type": "integer", "minimum": 0, "maximum": 3},
          "explanation": {"type": "string", "minLength": 20},
          "pitfall": {"type": "string"},
          "source_ids": {"type": "array", "minItems": 1},
          "level": {"type": "string", "enum": ["基础", "进阶", "高难"]},
          "review_status": {"type": "string", "minLength": 8}
        }
      }
    }
  }
}
