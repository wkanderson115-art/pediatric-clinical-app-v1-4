     "url": "https://www.nhc.gov.cn/fzs/c100048/202105/481e639c307a4effa14957f4d0d738fd.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-B69F0B4A3403D4",
   "kind": "基础专题",
   "item_id": "blood-06",
   "title": "儿童免疫性血小板减少症的分层处理",
   "category": "血液与肿瘤",
   "section": "检查与鉴别",
   "section_label": "检查与鉴别",
   "original_text": "复核血常规并做人工涂片排除血小板聚集造成的假性降低，必要时查网织血小板与免疫学指标；与药物性血小板减少、感染后抑制、白血病、再生障碍性贫血及血栓性微血管病鉴别，不典型者考虑骨髓检查。",
   "content_sha256": "1b7f31f91c7a64eca49f3b26d67a9f30c46de44f4bea49cf7667e4816a2cc394",
   "priority": "P2 常规",
   "sources": [
