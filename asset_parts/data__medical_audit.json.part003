     "url": "https://www.nhc.gov.cn/fzs/c100048/202105/481e639c307a4effa14957f4d0d738fd.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-FDB245AFC2B170",
   "kind": "基础专题",
   "item_id": "blood-06",
   "title": "儿童免疫性血小板减少症的分层处理",
   "category": "血液与肿瘤",
   "section": "处理与用药原则",
   "section_label": "处理与用药原则",
   "original_text": "按出血程度而非单纯血小板数值决定是否治疗，无出血或仅轻度皮肤出血者可观察随访；需治疗者由血液专科选择免疫球蛋白、糖皮质激素等方案，剂量按体重与说明书核对，同时避免肌内注射与剧烈碰撞。",
   "content_sha256": "9c9fd60c3c56ee511d6e36e4721f8edb8571b1c05e6ad87abd2ff2b0e098306b",
