  {
   "claim_id": "CLAIM-72FF3E4CFE6087",
   "kind": "循证练习题",
   "item_id": "cnq-069",
   "title": "教学讨论优先用脱敏病例",
   "category": "隐私与数据",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "医疗健康信息与不满14周岁未成年人的个人信息属于敏感个人信息，处理需具备合法性基础、特定目的与严格保护措施，并履行告知与同意等要求。教学讨论宜优先使用虚构或可靠去标识化的材料；仅删除姓名无法保证不可重新识别，内部标签也不能替代合法性依据与范围控制。",
   "content_sha256": "c87ea192ac0b5de93b0a176bc39a6df1f087d34c808715f45bf93fcdc330192a",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "中华人民共和国个人信息保护法",
     "url": "https://shca.miit.gov.cn/zwgk/zcwj/flfg/art/2022/art_ed935fe2807e4787bfb8ca8e659e5524.html"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
