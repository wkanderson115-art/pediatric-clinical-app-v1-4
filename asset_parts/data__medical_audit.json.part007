  },
  {
   "claim_id": "CLAIM-4F29C55661AD37",
   "kind": "循证练习题",
   "item_id": "cnq-030",
   "title": "抗菌药有指征才用",
   "category": "消化",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "急性感染性腹泻的抗菌药使用有明确指征，需结合临床表现与病原学证据判断，例如疑侵袭性细菌感染或重症病例；补液纠正脱水应贯穿治疗全程，止泻药不能替代补液、喂养与病因评估。",
   "content_sha256": "7269bb7db583999b7e05d4eaec0aa14371d401285076f1a4e9c56229ff15ef37",
   "priority": "P0 临床高风险",
   "sources": [
    {
     "name": "儿童急性感染性腹泻病诊疗规范（2020年版）",
     "url": "https://www.nhc.gov.cn/yzygj/c100068/202009/a0720947d2c744b49fc91b32d82293ef.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
