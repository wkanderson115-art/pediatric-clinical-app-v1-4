  },
  {
   "claim_id": "CLAIM-3B52872066C0FD",
   "kind": "循证练习题",
   "item_id": "cnq-043",
   "title": "重度脱水先评估循环",
   "category": "儿科急诊与重症",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "重度脱水伴灌注不良属于急诊情况，应立即评估循环与脱水程度，尽快建立静脉通路补液并监测生命体征、尿量与灌注。无法口服或循环不稳定的患儿不宜单纯口服补液观察，补液速度必须按儿童体重与规范要求计算，不能照搬成人经验。",
   "content_sha256": "096659bf700102a3c2592f706a0378224eb372a9735f1c0e38f5252ac6fe65ec",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "儿童急性感染性腹泻病诊疗规范（2020年版）",
     "url": "https://www.nhc.gov.cn/yzygj/c100068/202009/a0720947d2c744b49fc91b32d82293ef.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-05C1B0AD90F5C1",
   "kind": "循证练习题",
   "item_id": "cnq-043",
   "title": "重度脱水先评估循环",
   "category": "儿科急诊与重症",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "对循环不稳定的患儿仍坚持口服补液慢慢观察，或不经体重计算照搬成人输液速度。",
