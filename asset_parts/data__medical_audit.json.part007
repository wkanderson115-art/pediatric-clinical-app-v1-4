  {
   "claim_id": "CLAIM-EA7D7099AEA686",
   "kind": "循证练习题",
   "item_id": "cnq-037",
   "title": "28天以下不套儿童区间",
   "category": "新生儿",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "WS/T 780—2021 明确适用于28天至18岁儿童。出生28天以内的新生儿需按适合胎龄与日龄的参考体系解读结果，并结合喂养情况、体温、精神状态与血糖监测趋势综合判断，不能直接套用超出适用年龄的区间。",
   "content_sha256": "26cbc5658f9426d06e2e88b4ea43a5657e5438a63ae1f419b85f0bf58de60c62",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "WS/T 780—2021 儿童临床常用生化检验项目参考区间",
     "url": "https://www.nhc.gov.cn/wjw/s9492/202105/3d5159ef7619452b9842ea9520189a11.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-47B1A844ACA76D",
   "kind": "循证练习题",
   "item_id": "cnq-037",
   "title": "28天以下不套儿童区间",
