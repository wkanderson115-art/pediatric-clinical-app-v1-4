  {
   "claim_id": "CLAIM-202AF33992E601",
   "kind": "循证练习题",
   "item_id": "cnq-054",
   "title": "血肌酐「正常」要看年龄区间",
   "category": "泌尿",
   "section": "题干",
   "section_label": "题干",
   "original_text": "8岁患儿血肌酐62μmol/L，报告单成人参考上限为104μmol/L，家长认为「没超标就说明肾功能没问题」。最恰当的理解是？",
   "content_sha256": "9e666bc7ab0ab98ecd3a1b6049a56ce8c009e1fb9b87fa5a7d97d4a049397778",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "WS/T 780—2021 儿童临床常用生化检验项目参考区间",
     "url": "https://www.nhc.gov.cn/wjw/s9492/202105/3d5159ef7619452b9842ea9520189a11.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-ED7DDF6C16C87A",
   "kind": "循证练习题",
   "item_id": "cnq-054",
   "title": "血肌酐「正常」要看年龄区间",
   "category": "泌尿",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "儿童生化项目参考区间按年龄段划分，直接套用成人上限会把部分异常值判为正常。判读血肌酐须使用与患儿年龄匹配的参考区间，注意实验室方法与单位差异，并同时结合尿量、尿常规、影像等综合评估，不能仅凭单项指标确定或排除肾脏问题。",
   "content_sha256": "aac787133181efd8bc24a3c65304c2d7b48c34e37e05022e63888712c48370ef",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "WS/T 780—2021 儿童临床常用生化检验项目参考区间",
     "url": "https://www.nhc.gov.cn/wjw/s9492/202105/3d5159ef7619452b9842ea9520189a11.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
