    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-E48210E711DCEE",
   "kind": "循证练习题",
   "item_id": "cnq-060",
   "title": "血糖判读先确认检测条件",
   "category": "内分泌",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "血糖判读受标本类型、采血时间、是否空腹与单位影响，儿童参考区间也与成人不同。单次略高的结果不能直接作为诊断依据，应确认检测条件、按年龄匹配区间判读，并结合临床症状与必要的复核检测，由临床完成诊断；反过来，也不能以「儿童不一样」为由忽略异常结果。",
   "content_sha256": "8652c43822805be86463ca97b8433f9479c402b6de134a1856d626d8a12e6f50",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "WS/T 780—2021 儿童临床常用生化检验项目参考区间",
     "url": "https://www.nhc.gov.cn/wjw/s9492/202105/3d5159ef7619452b9842ea9520189a11.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-96482BB6317838",
   "kind": "循证练习题",
   "item_id": "cnq-060",
   "title": "血糖判读先确认检测条件",
   "category": "内分泌",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "用成人标准直接诊断，或反过来以「儿童不一样」为由忽略异常血糖值。",
