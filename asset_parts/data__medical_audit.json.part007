  },
  {
   "claim_id": "CLAIM-6D09264D9EC185",
   "kind": "循证练习题",
   "item_id": "cnq-066",
   "title": "参考区间不能跨年龄借用",
   "category": "检验",
   "section": "题干",
   "section_label": "题干",
   "original_text": "家长拿成人化验单的参考区间对照孩子的生化结果，判断「大部分都异常」。最恰当的说明是？",
   "content_sha256": "8f74e19bbb22cd4dd41692a69276565a80899dc8e0d0e3b4b4988d8d724c0024",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "WS/T 780—2021 儿童临床常用生化检验项目参考区间",
     "url": "https://www.nhc.gov.cn/wjw/s9492/202105/3d5159ef7619452b9842ea9520189a11.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-211B378668C509",
   "kind": "循证练习题",
   "item_id": "cnq-066",
   "title": "参考区间不能跨年龄借用",
   "category": "检验",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "儿童常用生化项目参考区间按年龄段分别给定，与成人区间存在实质差异。判读应使用报告实验室提供的、与患儿年龄匹配的参考区间，并确认单位一致；单位相同也不代表区间可通用，反过来也不能因为「是儿童」就放弃对照区间把结果全部判为正常，否则会同时造成过度检查和漏诊。",
   "content_sha256": "827feefe02a678e6fa6cce428a429d1355a52de8f82efb24f0a3076691dca98f",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "WS/T 780—2021 儿童临床常用生化检验项目参考区间",
     "url": "https://www.nhc.gov.cn/wjw/s9492/202105/3d5159ef7619452b9842ea9520189a11.shtml"
    }
