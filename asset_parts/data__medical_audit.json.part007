  {
   "claim_id": "CLAIM-EA6FD60118B3C7",
   "kind": "循证练习题",
   "item_id": "cnq-043",
   "title": "重度脱水先评估循环",
   "category": "儿科急诊与重症",
   "section": "题干",
   "section_label": "题干",
   "original_text": "1岁患儿腹泻2天，精神萎靡、眼窝深凹、四肢凉、毛细血管再充盈时间延长。首要处置是？",
   "content_sha256": "015905f0f618cb6696fbc3bacd194064c78a845cb28f3ac7cfb4fdb4aa324a4b",
   "priority": "P1 专科优先",
