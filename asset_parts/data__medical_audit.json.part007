  },
  {
   "claim_id": "CLAIM-78AEF2B9016AD0",
   "kind": "循证练习题",
   "item_id": "cnq-027",
   "title": "治疗无反应先重新评估",
   "category": "呼吸",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "肺炎支原体没有细胞壁，β-内酰胺类抗菌药不能直接针对其细胞壁发挥作用，换头孢并不能解决疗效不佳问题。治疗反应差时应重新评估诊断是否成立、病情严重程度、耐药可能、混合感染与并发症，再决定后续策略。",
   "content_sha256": "ad51db1cdbb3157c0b97ab36395c853e4e9a9b0bba9fb040a1cf26c7c73128c2",
   "priority": "P0 临床高风险",
   "sources": [
    {
     "name": "儿童肺炎支原体肺炎诊疗指南（2025年版）",
     "url": "https://www.nhc.gov.cn/yzygj/c100068/202509/19e7145436b049a68d4ba8c2060dfa56.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-3EF195C34C9E16",
   "kind": "循证练习题",
   "item_id": "cnq-027",
   "title": "治疗无反应先重新评估",
   "category": "呼吸",
   "section": "常见易错点",
