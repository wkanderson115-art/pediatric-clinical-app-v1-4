  },
  {
   "claim_id": "CLAIM-F2894FB4E72762",
   "kind": "循证练习题",
   "item_id": "cnq-070",
   "title": "儿童用药项不明确不能当依据",
   "category": "药品核验",
   "section": "题干",
   "section_label": "题干",
   "original_text": "某药在第三方接口能查到，但其说明书「儿童用药」项内容不明确，离线药典条目来源标注为第三方整理。此时的正确判断是？",
   "content_sha256": "e4fdfdbb61325980132b6a1a11dbebea2c1636858e62fa4facb73737cab3dbde",
   "priority": "P1 专科优先",
   "sources": [
