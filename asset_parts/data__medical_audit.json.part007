  },
  {
   "claim_id": "CLAIM-A46EA0D3EDCA27",
   "kind": "循证练习题",
   "item_id": "cnq-055",
   "title": "过敏史必须写清药名与反应",
   "category": "过敏与免疫",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "药物过敏史是病历中的必需事实，应记录可疑药物名称、反应类型与发生时间等可核对信息，并在开具与执行医嘱时再次核对。写成「无过敏史」会使后续用药失去警示，只写「过敏体质」或仅靠口头交接都无法形成可追溯的核对环节，容易导致再次暴露。",
   "content_sha256": "7234067d9458dbb2ccdae92bbb02372d1bd3e7ae83da1000bc8a1dc997084bd2",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "病历书写基本规范（2010）",
     "url": "https://www.nhc.gov.cn/wjw/c100175/201002/b1bec53d90f243e0861529723f00221a.shtml"
    },
    {
     "name": "国家药监局药品数据查询",
     "url": "https://datasearch.nmpa.gov.cn/"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-AFBB99688138AC",
   "kind": "循证练习题",
   "item_id": "cnq-055",
   "title": "过敏史必须写清药名与反应",
   "category": "过敏与免疫",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "把严重过敏反应简写成「无过敏史」或「过敏体质」，只靠口头交接而不写入病历。",
   "content_sha256": "b15b757926bee919f0d125f53b6b180462eb43f42caa318b48521f9393a1abdf",
