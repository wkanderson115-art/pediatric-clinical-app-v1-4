  },
  {
   "claim_id": "CLAIM-D97F6AC3B29CAA",
   "kind": "循证练习题",
   "item_id": "cnq-050",
   "title": "批准文号不等于说明书已核验",
   "category": "药品核验",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "第三方接口返回的匹配结果不等同于官方注册信息核验。批准文号、生产企业、剂型规格与说明书版本是相互独立的核对项，儿童用药的用法用量信息必须以说明书原文为准，并到官方数据查询入口人工复核。",
   "content_sha256": "47b01e5a3173f55d2ac79bc132be1997e3d8ecf4e1994ca5a45c87de534ccfc5",
   "priority": "P1 专科优先",
   "sources": [
