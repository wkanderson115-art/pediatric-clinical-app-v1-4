    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-34EE53897E8A68",
   "kind": "循证练习题",
   "item_id": "cnq-059",
   "title": "发绀患儿血红蛋白升高要综合看",
   "category": "心血管",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "慢性缺氧可刺激红细胞生成，使血红蛋白代偿性升高；判读时须使用与年龄匹配的参考区间，并结合血氧饱和度、血细胞比容、症状与随访趋势综合评估。是否需要干预由专科结合具体情况判断，不能仅凭一次高于上限的数值就采取放血等处置，也不能反推为缺铁。",
   "content_sha256": "b6c38d7f249cc7e3db438ffe134c5b57ed2cec044d891ed4989cd1ad4103593d",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "WS/T 779—2021 儿童血细胞分析参考区间",
     "url": "https://www.nhc.gov.cn/fzs/c100048/202105/481e639c307a4effa14957f4d0d738fd.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-9843EC78495C78",
   "kind": "循证练习题",
   "item_id": "cnq-059",
   "title": "发绀患儿血红蛋白升高要综合看",
   "category": "心血管",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "见到血红蛋白高于上限就直接放血，或把代偿性升高误判为缺铁而加大补铁。",
   "content_sha256": "bdfd58c437c9535d0690b86facbb5b0fbd10fa7d333a334c945ff7f9f3f3ca29",
