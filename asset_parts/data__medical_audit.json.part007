  },
  {
   "claim_id": "CLAIM-1E2076CBE91FBD",
   "kind": "循证练习题",
   "item_id": "cnq-056",
   "title": "新生儿血细胞不看儿童界值",
   "category": "新生儿",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "血细胞分析参考区间按年龄分段给出，新生儿期受日龄、采血部位与生理性波动影响明显。判读时须使用与日龄匹配的区间，并结合临床表现、网织红细胞等其他指标综合判断；单凭一次血红蛋白数值套用较大儿童界值就决定输血，会带来不必要的处置与风险。",
   "content_sha256": "00b066e7d01b954176c9ea3af3bdd3eabf50b8b2d798ebd6102cd28d799c8097",
   "priority": "P1 专科优先",
   "sources": [
