  },
  {
   "claim_id": "CLAIM-E36E5CB0F50A32",
   "kind": "循证练习题",
   "item_id": "cnq-061",
   "title": "贫血界值随年龄变化",
   "category": "血液",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "儿童血红蛋白参考区间按年龄分段，婴儿期与学龄期界值不同，套用成人界值既可能漏判也可能误判。判读贫血应使用与患儿年龄匹配的区间，同时看红细胞平均体积等指数、结合喂养与病史、必要时随访复查，才能区分缺铁等原因，单看一个数值不足以下结论。",
   "content_sha256": "d56b37b578e9f508ae19fda167ef4365fb9adafc8252d509ea02f17b05d98192",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "WS/T 779—2021 儿童血细胞分析参考区间",
     "url": "https://www.nhc.gov.cn/fzs/c100048/202105/481e639c307a4effa14957f4d0d738fd.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-6F84CE5AF71D7F",
   "kind": "循证练习题",
   "item_id": "cnq-061",
   "title": "贫血界值随年龄变化",
   "category": "血液",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "用成人血红蛋白界值判读婴幼儿，或只看血红蛋白而不看红细胞指数与病史。",
   "content_sha256": "81958f16eddae8102a9bccf35f87f6813171b1ec122c9d346c8072385963e923",
   "priority": "P1 专科优先",
