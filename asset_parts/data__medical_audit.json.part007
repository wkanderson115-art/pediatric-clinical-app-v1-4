   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-E5482EA939F228",
   "kind": "循证练习题",
   "item_id": "cnq-026",
   "title": "影像描述不等于病原诊断",
   "category": "呼吸",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "胸片上的片状影只说明炎症分布形态，不能确定病原。儿童肺炎的诊断与治疗分层需要结合临床表现、呼吸做功与氧合状态、以及病原学证据综合判断，单凭影像描述既不能认定为细菌感染，也不能认定为支原体感染。",
   "content_sha256": "ae9dd49f962a08d2c40b5e9a826791e8d7a71a27c7f9b130f507f7897de61488",
   "priority": "P0 临床高风险",
   "sources": [
    {
     "name": "儿童肺炎支原体肺炎诊疗指南（2025年版）",
     "url": "https://www.nhc.gov.cn/yzygj/c100068/202509/19e7145436b049a68d4ba8c2060dfa56.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-9B6DA475E17649",
   "kind": "循证练习题",
   "item_id": "cnq-026",
   "title": "影像描述不等于病原诊断",
