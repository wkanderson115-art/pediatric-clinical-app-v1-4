   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-773A2263BE6AA2",
   "kind": "循证练习题",
   "item_id": "cnq-052",
   "title": "口服补液盐要按标注水量冲",
   "category": "消化",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "口服补液盐的电解质与葡萄糖浓度由配制水量决定，水量与说明书不符会改变溶液的渗透浓度，影响补液与吸收效果，冲调时也不应额外加糖或兑果汁。腹泻患儿应先评估脱水程度再以口服补液为主，能饮水不等于不需要补充电解质，白开水不能替代口服补液盐。",
   "content_sha256": "62a851e93daa5746d61f10851609ea41c949b33e3afb81d4f81c8790b7547f35",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "儿童急性感染性腹泻病诊疗规范（2020年版）",
     "url": "https://www.nhc.gov.cn/yzygj/c100068/202009/a0720947d2c744b49fc91b32d82293ef.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-9A53073F92AE3D",
   "kind": "循证练习题",
   "item_id": "cnq-052",
   "title": "口服补液盐要按标注水量冲",
   "category": "消化",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "自行改变配制水量，或用果汁、白开水替代口服补液盐，忽略浓度对渗透压的影响。",
   "content_sha256": "3f24b1d28011ca640d7bf589845105b47c05e1d1eeb196807542dad9caa25b6d",
