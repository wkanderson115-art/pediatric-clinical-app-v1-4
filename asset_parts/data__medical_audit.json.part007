   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-D0FD0E6C4EA997",
   "kind": "循证练习题",
   "item_id": "cnq-070",
   "title": "儿童用药项不明确不能当依据",
   "category": "药品核验",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "药品核验要区分「查到了这个药」与「确认了儿童用法」。当说明书儿童用药项内容不明确，或离线条目来源为第三方整理时，该信息不能作为儿童可用的依据；应到官方数据查询入口人工核对批准文号、生产企业、剂型规格与说明书版本，并与处方医师确认，避免把来源标注当成用法依据。",
   "content_sha256": "b5b81d7c33869929a4d9e48c3f54caba20ffed532357a5aa5614bf94355fb82b",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "国家药监局药品数据查询",
     "url": "https://datasearch.nmpa.gov.cn/"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-90CB85F2CB1914",
   "kind": "循证练习题",
   "item_id": "cnq-070",
   "title": "儿童用药项不明确不能当依据",
   "category": "药品核验",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "把第三方整理条目或「儿童用药不明确」当成儿童可安全使用的依据，跳过说明书版本与注册信息核对。",
   "content_sha256": "ebb8febbf93bdc7c8b9184e857e3b9a6bb8413eaf314f5365df647d3f887496b",
