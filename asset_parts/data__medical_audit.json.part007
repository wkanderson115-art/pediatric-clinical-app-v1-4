  },
  {
   "claim_id": "CLAIM-C9868DA8F7DBD5",
   "kind": "循证练习题",
   "item_id": "cnq-064",
   "title": "药典剂量范围不是处方",
   "category": "临床药学",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "教学性剂量范围是对用药思路的概括，不等于某一患儿可执行的处方。实际给药须依据说明书标注的适应证、用法用量与上限，结合体重或体表面积、肝肾功能与合并用药确定，并由医师开具、药师审核。范围与上限也不能理解为「越大越有效」，超出上限不增加疗效反而增加风险。",
   "content_sha256": "1bb4b1b73726a212499d66696c5ce98c904c662b8e7e74b645a67209a5d084a3",
   "priority": "P0 临床高风险",
   "sources": [
    {
     "name": "国家药监局药品数据查询",
     "url": "https://datasearch.nmpa.gov.cn/"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-49EE6E662D687F",
   "kind": "循证练习题",
   "item_id": "cnq-064",
   "title": "药典剂量范围不是处方",
   "category": "临床药学",
   "section": "常见易错点",
   "section_label": "常见易错点",
