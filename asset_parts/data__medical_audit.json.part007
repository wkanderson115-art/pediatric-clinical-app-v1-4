  },
  {
   "claim_id": "CLAIM-0CAB13D38DFEFD",
   "kind": "循证练习题",
   "item_id": "cnq-047",
   "title": "占位符不能替代必需事实",
   "category": "病历质控",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "病历必须真实、完整、及时。生命体征与现病史属于必需事实，不能用占位符、模板描述或人群平均值替代。确需补记的应按机构制度据实完成并留下可追溯记录，复制他人病历更是严重违反病历真实性要求。",
   "content_sha256": "7bd1f1dbd16c152723a91be1443b72e89102561d66f3744e06fc51b19f98cf2a",
   "priority": "P1 专科优先",
