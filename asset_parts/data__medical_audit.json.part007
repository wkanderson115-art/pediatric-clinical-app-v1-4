   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-882640648DB627",
   "kind": "循证练习题",
   "item_id": "cnq-035",
   "title": "急救用药先核对剂型浓度",
   "category": "过敏与免疫",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "严重过敏反应的救治以肌内注射肾上腺素为核心，不同浓度与剂型对应不同给药途径，用错浓度会造成实际剂量错误。给药前必须核对药品规格、浓度、途径与有效期，剂量按规范要求与患儿体重计算，并同步评估气道、呼吸与循环。",
   "content_sha256": "94662bc6c732f8c40a16f27fbeee085860a54d05c1d78a79787b4f62f8cff3f8",
   "priority": "P0 临床高风险",
   "sources": [
    {
     "name": "国家药监局药品数据查询",
     "url": "https://datasearch.nmpa.gov.cn/"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-4A93545B741036",
   "kind": "循证练习题",
   "item_id": "cnq-035",
   "title": "急救用药先核对剂型浓度",
   "category": "过敏与免疫",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "只看药名不看浓度与剂型，把稀释液当原液，或把原液当稀释液使用，导致实际给药量严重偏差。",
   "content_sha256": "51bf13b991418f8ba5a8ef0b996ad8f4f3176e515972c96591b9cad560ea88e1",
