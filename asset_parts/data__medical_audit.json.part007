  },
  {
   "claim_id": "CLAIM-2873001BF6EDC2",
   "kind": "循证练习题",
   "item_id": "cnq-065",
   "title": "单次上限不能跨剂型套用",
   "category": "临床药学",
   "section": "题干",
   "section_label": "题干",
   "original_text": "同一药物既有口服混悬剂又有注射剂，两种剂型说明书标注的单次上限不同。以下理解正确的是？",
   "content_sha256": "1bf8dfa2d4b902323646393ca4e94f0b031756cb0d2046f5095a16243ac8c11a",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "国家药监局药品数据查询",
     "url": "https://datasearch.nmpa.gov.cn/"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-D64A2B7EE9C52E",
   "kind": "循证练习题",
   "item_id": "cnq-065",
   "title": "单次上限不能跨剂型套用",
   "category": "临床药学",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "不同剂型的给药途径、吸收过程、浓度与辅料不同，说明书标注的单次量与日总量也各自独立。核对时必须按实际使用的剂型与规格查对应说明书，不能把注射剂或另一剂型的上限套用到口服制剂，也不能以「日总量不超」为理由任意改变单次量，混悬剂还需按标示浓度换算实际取量。",
   "content_sha256": "2e227fad148aa430fecbd7669cb5d356765cf0e41739ad6a4d9d3fccbef7d1fd",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "国家药监局药品数据查询",
     "url": "https://datasearch.nmpa.gov.cn/"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-71B40E68F1B250",
   "kind": "循证练习题",
   "item_id": "cnq-065",
   "title": "单次上限不能跨剂型套用",
   "category": "临床药学",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "把注射剂上限套用到口服剂型，或用日总量控制代替单次量与浓度换算核对。",
   "content_sha256": "1543a93b30d19c1832b4ab5d049897dc7e5215de648ccdc27c826aca2694078d",
   "priority": "P1 专科优先",
   "sources": [
