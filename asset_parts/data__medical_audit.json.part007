     "name": "国家药监局药品数据查询",
     "url": "https://datasearch.nmpa.gov.cn/"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-C0494198B4B35D",
   "kind": "循证练习题",
   "item_id": "cnq-058",
   "title": "止惊药不凭经验追加",
   "category": "神经",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "止惊药的给药途径、单次量、可重复间隔与总量上限都以说明书和本院急救流程为依据，超量或过密追加会带来呼吸抑制等风险。操作中须记录每次给药时间与剂量、同步监测呼吸与循环，并按流程评估是否需要升级处置；成人剂量对半折算或多种药物同时推注都不是可执行的做法。",
   "content_sha256": "b11f1e847c017d5a7818c63d47022e8e5655ae26d40133bb28859e6c3ef7940f",
   "priority": "P0 临床高风险",
   "sources": [
    {
     "name": "国家药监局药品数据查询",
     "url": "https://datasearch.nmpa.gov.cn/"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-1962D8DE1B75A7",
   "kind": "循证练习题",
   "item_id": "cnq-058",
   "title": "止惊药不凭经验追加",
   "category": "神经",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "按「反复追加直到停止」或成人剂量对半折算给药，忽略呼吸抑制风险与给药间隔。",
   "content_sha256": "6b73430906f7348528db6945b8592ab97656b51f527dc05d954514f886f6e9ce",
