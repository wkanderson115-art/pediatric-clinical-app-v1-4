  {
   "claim_id": "CLAIM-5AF568A9CD137C",
   "kind": "循证练习题",
   "item_id": "cnq-053",
   "title": "水样便不是抗菌药指征",
   "category": "消化",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "儿童急性感染性腹泻的核心是评估脱水程度、合理补液与继续喂养，抗菌药只用于有明确指征的情形。无血便、无高热、一般状况良好的水样便患儿不常规使用抗菌药，滥用会增加不良反应与耐药风险；同时也不能忽略精神、尿量、口渴等危险信号的随访。",
   "content_sha256": "93afe363fc2333742a7d7604a507ae70c2904bf0fdd914fefd2cea345f05eafa",
   "priority": "P0 临床高风险",
   "sources": [
    {
     "name": "儿童急性感染性腹泻病诊疗规范（2020年版）",
     "url": "https://www.nhc.gov.cn/yzygj/c100068/202009/a0720947d2c744b49fc91b32d82293ef.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-E2CA414DE95CA7",
   "kind": "循证练习题",
   "item_id": "cnq-053",
   "title": "水样便不是抗菌药指征",
   "category": "消化",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "把腹泻次数多等同于需要抗菌药，或只盯着大便性状而漏掉脱水与危险信号评估。",
