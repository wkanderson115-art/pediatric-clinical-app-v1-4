  },
  {
   "claim_id": "CLAIM-427A42FED5F5DD",
   "kind": "循证练习题",
   "item_id": "cnq-061",
   "title": "贫血界值随年龄变化",
   "category": "血液",
   "section": "题干",
   "section_label": "题干",
   "original_text": "1岁幼儿血红蛋白108g/L，判断是否属于贫血的正确方式是？",
   "content_sha256": "9c8622907d40ff3c6a7c7edaf1d270b5abefef0665d354fe79762cba5f4ece45",
   "priority": "P1 专科优先",
   "sources": [
