  },
  {
   "claim_id": "CLAIM-09883584E5232B",
   "kind": "循证练习题",
   "item_id": "cnq-051",
   "title": "影像进展不等于加药",
   "category": "呼吸",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "支原体肺炎治疗无反应或影像进展时，应回到诊断与病情评估：复核严重程度分层、是否耐药或存在混合感染、有无胸腔积液等并发症，而不是把影像进展直接等同于剂量不足。影像吸收常滞后于临床好转，也不能以影像完全正常作为停药条件，需继续随访危险信号。",
   "content_sha256": "4451780c9bead7f04dbc6e1f4367a4f48c8eec62e63905a23bd995e0022c2a95",
   "priority": "P0 临床高风险",
   "sources": [
    {
     "name": "儿童肺炎支原体肺炎诊疗指南（2025年版）",
     "url": "https://www.nhc.gov.cn/yzygj/c100068/202509/19e7145436b049a68d4ba8c2060dfa56.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-B4E0ECA3F57768",
   "kind": "循证练习题",
   "item_id": "cnq-051",
   "title": "影像进展不等于加药",
   "category": "呼吸",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "把胸片进展当成剂量不足而自行加量，或用影像是否完全吸收作为停药标准。",
