   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-7DA6699299726A",
   "kind": "循证练习题",
   "item_id": "cnq-057",
   "title": "首次惊厥先找可逆病因",
   "category": "神经",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "首次惊厥的评估重点是排除低血糖、电解质紊乱、感染等可逆病因，并评估生命体征、意识与神经系统体征；血糖等生化指标须按儿童年龄匹配的参考区间判读。病因与诊断尚未明确前不应直接开始长期抗癫痫治疗，也不必把基因检测放在优先位置。",
   "content_sha256": "d876cc1fb9b0612d29d3371292805061d4d756071103c0bdeced08be67785f02",
   "priority": "P0 临床高风险",
   "sources": [
    {
     "name": "WS/T 780—2021 儿童临床常用生化检验项目参考区间",
     "url": "https://www.nhc.gov.cn/wjw/s9492/202105/3d5159ef7619452b9842ea9520189a11.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-4C9AEBBB1C3A17",
   "kind": "循证练习题",
   "item_id": "cnq-057",
   "title": "首次惊厥先找可逆病因",
   "category": "神经",
   "section": "常见易错点",
   "section_label": "常见易错点",
   "original_text": "首次惊厥就启动长期抗癫痫药，或不查血糖、电解质等可逆病因只记录发作表现。",
   "content_sha256": "b98c462669f94826924f448f099819278e7fe0c6a5a23d97e655ef60b9a0fe6c",
