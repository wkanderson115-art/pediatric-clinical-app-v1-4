  {
   "claim_id": "CLAIM-846E421C0D9EC7",
   "kind": "循证练习题",
   "item_id": "cnq-028",
   "title": "低氧优先于化验回报",
   "category": "呼吸",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "呼吸做功增加与低氧是重症肺炎的危险信号，属于需要立即干预的维度，优先级高于炎症指标的回报时间。应先行氧合支持与急诊危险分层，评估是否需要呼吸支持、监护与转诊，而不是等化验结果。",
   "content_sha256": "923f94a7c653e668a54e016661e012a023d748aa75d2198c870019eaa348a8c2",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "儿童肺炎支原体肺炎诊疗指南（2025年版）",
     "url": "https://www.nhc.gov.cn/yzygj/c100068/202509/19e7145436b049a68d4ba8c2060dfa56.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
  {
   "claim_id": "CLAIM-647A776F22C418",
   "kind": "循证练习题",
   "item_id": "cnq-028",
   "title": "低氧优先于化验回报",
   "category": "呼吸",
   "section": "常见易错点",
