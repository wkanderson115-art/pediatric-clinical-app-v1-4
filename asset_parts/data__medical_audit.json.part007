  },
  {
   "claim_id": "CLAIM-4996A3CB83AEB1",
   "kind": "循证练习题",
   "item_id": "cnq-038",
   "title": "惊厥记录要写实",
   "category": "神经",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "病程记录应当客观、真实、完整、及时、可追溯地反映病情变化与诊疗过程。惊厥发作的时间、形式、持续时间、意识恢复情况与伴随体征是判断病因和复发风险的关键事实，不能用概括词、占位描述或转引他处记录来替代。",
   "content_sha256": "7ef20b49e5659da7fd2469946f2d93b4db0bd2f4cc40516ff294777f7913e0d8",
   "priority": "P1 专科优先",
