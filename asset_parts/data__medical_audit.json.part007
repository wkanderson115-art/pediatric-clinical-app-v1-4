  },
  {
   "claim_id": "CLAIM-00F20B8AE96C5B",
   "kind": "循证练习题",
   "item_id": "cnq-059",
   "title": "发绀患儿血红蛋白升高要综合看",
   "category": "心血管",
   "section": "题干",
   "section_label": "题干",
   "original_text": "发绀型先天性心脏病患儿血红蛋白高于同龄参考上限，家长担心「血太稠要放血」。恰当的学习性理解是？",
   "content_sha256": "e4f472dd00784f041d194d8173c9248e6ac8a2d59bb6b7327238869a79fb1657",
   "priority": "P1 专科优先",
   "sources": [
    {
