  {
   "claim_id": "CLAIM-0B5A10607A46CB",
   "kind": "循证练习题",
   "item_id": "cnq-068",
   "title": "病程记录不能用共享模板",
   "category": "病历质控",
   "section": "答案解析",
   "section_label": "答案解析",
   "original_text": "病程记录是反映患儿病情变化、处置依据与效果的连续记录，必须真实、具体、与个体情况相符。统一套用与病情不符的模板、只更换日期与签名，会使记录失去临床信息价值，属于病历真实性与完整性的质控问题；本人签名与提高效率都不能弥补内容失真，一旦发生争议更难自证。",
   "content_sha256": "d5e599244731c6dee68e5afe9934bceb345f74e9df71997cbeb8f6de4c6f4b4c",
   "priority": "P1 专科优先",
   "sources": [
    {
     "name": "病历书写基本规范（2010）",
     "url": "https://www.nhc.gov.cn/wjw/c100175/201002/b1bec53d90f243e0861529723f00221a.shtml"
    }
   ],
   "evidence_status": "有候选来源入口，尚未定位原文",
   "medical_review_status": "未进行专家逐条审核",
   "reviewer_role": "儿科医生+医学教育审核人",
   "evidence_locator": "",
   "evidence_quote": "",
   "reviewer_name": "",
   "review_date": "",
   "review_result": "待审核",
   "review_notes": "",
   "change_needed": "",
   "source_alignment": "未逐句核验（不能由链接自动推出医学正确性）"
  },
