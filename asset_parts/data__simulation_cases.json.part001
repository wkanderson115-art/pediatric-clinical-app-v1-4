        ],
        "focus": "住院给药监测与治疗反应判断",
        "objectives": [
          "核对适应证与疗程方向",
          "监测治疗反应与不良反应",
          "评估氧合与影像变化",
          "安排复评与方案调整"
        ],
        "debrief": "复盘重点：给药前核对病原方向与方案匹配度，疗效不佳须先排除混合感染再调方案。"
      },
      {
        "archetype_id": "iv_bron",
