  "cases": [
    {
      "id": "resp_virus",
      "system": "呼吸",
      "title": "普通上呼吸道感染",
      "age": 4,
      "sex": "女",
      "weight_kg": 17,
      "setting": "儿科门诊",
      "chief": "咳嗽、流涕2天",
      "vitals": "T 37.7℃ · HR 105次/分 · RR 23次/分 · SpO₂ 99%",
      "opening": "家长：孩子鼻塞，昨夜咳嗽多了点，我担心是肺炎。",
      "history": [
        {
          "id": "duration",
          "label": "询问病程和最高体温",
          "reply": "流鼻涕、咽部不适2天，最高37.8℃，精神好。"
        },
        {
          "id": "breath",
          "label": "询问呼吸困难",
          "reply": "没有呼吸急促、胸凹陷或喘憋。"
        },
        {
          "id": "feed",
          "label": "询问进食饮水和尿量",
          "reply": "饮水正常，尿量正常。"
        },
        {
          "id": "exposure",
          "label": "询问接触史",
          "reply": "幼儿园有同学感冒。"
        }
      ],
      "examinations": [
        {
          "id": "chest",
          "label": "听诊肺部",
          "result": "双肺呼吸音清，未闻及局灶啰音。"
        },
        {
          "id": "throat",
          "label": "检查鼻咽",
          "result": "鼻黏膜充血，咽部轻度发红。"
        },
        {
          "id": "hydration",
          "label": "评估一般情况",
          "result": "精神好，末梢循环正常，无脱水征象。"
        }
      ],
      "tests": [
        {
          "id": "cbc",
          "label": "血常规",
          "result": "WBC 7.5×10⁹/L；单次结果不能排除感染，也不能单独判定病原。",
          "duration_min": 20
        },
        {
          "id": "xray",
          "label": "胸片",
          "result": "教学提示：无肺炎警示征时通常不需要例行影像检查。",
          "duration_min": 40
        },
        {
          "id": "pox",
          "label": "脉搏血氧复核",
          "result": "SpO₂ 99%（室内空气）。",
          "duration_min": 2
        }
      ],
      "diagnoses": [
        "病毒性上呼吸道感染",
        "细菌性支气管肺炎",
        "支气管哮喘急性发作"
      ],
      "drugs": [
        "无需抗菌药",
        "阿奇霉素",
        "头孢曲松静脉注射"
      ],
      "plans": [
        "观察呼吸与补液/休息的支持处理",
        "给予静脉抗菌药",
        "告知持续高热、呼吸困难等复诊警示"
      ],
      "expected": {
        "diagnosis": "病毒性上呼吸道感染",
        "history": [
          "breath",
          "feed"
        ],
        "exams": [
          "chest"
        ],
        "tests": [
          "pox"
        ],
        "drug": [
          "无需抗菌药"
        ],
        "plan": [
          "观察呼吸与补液/休息的支持处理",
          "告知持续高热、呼吸困难等复诊警示"
        ],
        "harmful": [
          "头孢曲松静脉注射",
          "给予静脉抗菌药"
        ]
      },
      "reasoning": "没有肺炎证据或并发症的普通感冒通常不需要抗菌药；评估危险信号，向家属交代观察重点。",
      "source_ids": [
        "cdc_peds"
      ],
      "urgent": false,
      "course": {}
    },
    {
      "id": "resp_cap",
      "system": "呼吸",
      "title": "疑似细菌性社区获得性肺炎",
      "age": 4,
      "sex": "男",
      "weight_kg": 16,
      "setting": "儿科门诊转急诊观察",
      "chief": "发热、咳嗽4天，呼吸增快",
      "vitals": "T 39.3℃ · HR 136次/分 · RR 42次/分 · SpO₂ 94%",
      "opening": "家长：孩子烧了几天，咳得越来越厉害，今天呼吸很快。",
      "history": [
        {
          "id": "duration",
          "label": "询问病程与最高体温",
          "reply": "发热4天，最高39.5℃，近1天咳嗽明显加重。"
        },
        {
          "id": "breath",
          "label": "询问呼吸困难及精神状态",
          "reply": "活动后明显气促，今天不愿玩耍。"
        },
        {
          "id": "feed",
          "label": "询问饮水和尿量",
          "reply": "喝水减少，但仍有尿；无频繁呕吐。"
        },
        {
          "id": "allergy",
          "label": "询问药物过敏及近期抗菌药",
          "reply": "无已知青霉素过敏史，尚未用过抗菌药。"
        }
      ],
      "examinations": [
        {
          "id": "severity",
          "label": "评估呼吸功及循环",
          "result": "呼吸增快，轻度胸壁凹陷；清醒，末梢灌注尚可。"
        },
        {
          "id": "chest",
          "label": "肺部听诊",
          "result": "右下肺局灶细湿啰音，呼吸音降低。"
        },
        {
          "id": "hydration",
          "label": "评估水分状态",
          "result": "口唇稍干，需继续评估液体需要。"
        }
      ],
      "tests": [
        {
          "id": "pox",
          "label": "持续监测氧合",
          "result": "室内空气SpO₂ 94%，需要结合临床状况复评。",
          "duration_min": 3
        },
        {
          "id": "xray",
          "label": "按指征胸片",
          "result": "右下肺局灶性实变影（虚构影像报告），可支持肺炎诊断，但不能独立定病原。",
          "duration_min": 35
        },
        {
          "id": "cbc",
          "label": "血常规/炎症指标",
          "result": "WBC 17.2×10⁹/L；CRP 52 mg/L（模拟）。不能仅凭血象确诊细菌病原。",
          "duration_min": 20
        }
      ],
      "diagnoses": [
        "社区获得性肺炎（考虑典型细菌病原）",
        "普通上呼吸道感染",
        "急性哮喘发作"
      ],
      "drugs": [
        "根据严重程度及当地路径选择窄谱β-内酰胺抗菌治疗",
        "单用阿奇霉素覆盖所有普通细菌性肺炎",
        "无评估直接常规广谱抗菌药联合用药"
