          "iv_bron_4"
        ],
        "focus": "住院补液与氧合支持的动态调整",
        "objectives": [
          "判断补液指征与喂养支持方式",
          "监测呼吸作功与氧合趋势",
          "核对输液安全要点",
          "安排出院前复评"
        ],
        "debrief": "复盘重点：以支持治疗为主，补液强度须随喂养恢复情况逐步下调。"
      },
