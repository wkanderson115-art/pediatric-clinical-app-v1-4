        "objectives": [
          "核对静脉治疗的指征",
          "完成给药前身份与体重核对",
          "识别治疗反应不佳的信号",
          "安排转口服与出院评估"
        ],
        "debrief": "复盘重点：静脉给药不是默认选项，复评结果决定能否降级与出院。"
      },
      {
        "archetype_id": "iv_mpp",
        "title": "重症支原体肺炎住院给药（教学主场景）",
