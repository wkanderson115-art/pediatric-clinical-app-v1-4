# 选择 auto / tianapi / moseng；auto优先选择摩熵，其次天聚数行
DRUG_PROVIDER=auto
TIANAPI_KEY=
MOSENG_API_KEY=

# 可选：疑难问题AI辅助学习。AI Key仅保存在服务器，不写入任何iPhone页面。
# V1.4 固定调用 DeepSeek 官方地址和 deepseek-flash，不需要配置 URL 或模型名。
AI_API_KEY=
# 必需：开启AI时要设置至少8位的访问码，避免公网滥用你的AI额度。
APP_ACCESS_CODE=

# V1.0 独立OCR访问码（至少8位，部署时自定义；与AI访问码不同）
OCR_ACCESS_CODE=

# V1.4 管理中心，仅服务端使用，任何值不得写进网页/公开仓库
# 至少16字符；部署到公网时务必使用独立强密码
ADMIN_PASSWORD=
# 用 cryptography.fernet.Fernet.generate_key() 生成，不与管理员密码相同
APP_SECRET_ENCRYPTION_KEY=
# 持久化磁盘/容器卷中的加密密钥文件路径
APP_SECRET_FILE=/srv/private/secrets.enc

# HTTPS 由 Nginx/Caddy 等反向代理终止时，填写代理连接到本容器的 IP 或 CIDR。
# 仅填写你实际控制的代理地址；直接部署且无反向代理时保持 127.0.0.1。
FORWARDED_ALLOW_IPS=127.0.0.1
