# 选择 auto / custom / tianapi / moseng
# auto 的优先级：custom（自建或任意第三方） > moseng > tianapi；都没有则自动使用离线药典
DRUG_PROVIDER=auto
TIANAPI_KEY=
MOSENG_API_KEY=

# 可选：自建 / 任意第三方药品接口（个人拿不到摩熵时用这条）
# 只要接口返回 JSON，就能用字段映射接进来，代码不用改。
# 示例：易源 ShowAPI 药品信息查询（apiCode 1468）
#   CUSTOM_DRUG_API_URL=https://route.showapi.com/1468-1
#   CUSTOM_DRUG_API_METHOD=GET
#   CUSTOM_DRUG_API_EXTRA_QUERY={"showapi_appid":"<appid>","showapi_sign":"<签名>"}
#   CUSTOM_DRUG_API_QUERY_PARAM=keyword
#   CUSTOM_DRUG_API_LIST_PATH=showapi_res_body.list
#   CUSTOM_DRUG_API_FIELD_MAP={"name":"title","content":"content"}
# 示例：openFDA（英文，免费 Key，120k 次/日）
#   CUSTOM_DRUG_API_URL=https://api.fda.gov/drug/label.json
#   CUSTOM_DRUG_API_QUERY_PARAM=search
#   CUSTOM_DRUG_API_EXTRA_QUERY={"limit":"5"}
#   CUSTOM_DRUG_API_KEY_PARAM=api_key
#   CUSTOM_DRUG_API_KEY=<openFDA key>
#   CUSTOM_DRUG_API_LIST_PATH=results
#   CUSTOM_DRUG_API_FIELD_MAP={"name":"openfda.brand_name.0","manufacturer":"openfda.manufacturer_name.0","approval_number":"set_id"}
#   CUSTOM_DRUG_API_SECTIONS_KEY=   # 留空表示没有 sections 数组，回退取 content 字段
CUSTOM_DRUG_API_URL=
CUSTOM_DRUG_API_METHOD=GET
CUSTOM_DRUG_API_BODY_FORMAT=json
CUSTOM_DRUG_API_KEY=
CUSTOM_DRUG_API_KEY_HEADER=
CUSTOM_DRUG_API_KEY_PREFIX=
CUSTOM_DRUG_API_KEY_PARAM=
CUSTOM_DRUG_API_QUERY_PARAM=q
CUSTOM_DRUG_API_PAGE_PARAM=page
CUSTOM_DRUG_API_EXTRA_QUERY={}
CUSTOM_DRUG_API_EXTRA_BODY={}
CUSTOM_DRUG_API_LIST_PATH=data
CUSTOM_DRUG_API_FIELD_MAP={}
CUSTOM_DRUG_API_SECTIONS_KEY=sections
CUSTOM_DRUG_API_SECTION_TITLE=title
CUSTOM_DRUG_API_SECTION_CONTENT=content
CUSTOM_DRUG_API_SOURCE=自定义药品接口
CUSTOM_DRUG_API_SOURCE_URL=

# 可选：疑难问题AI辅助学习。AI Key仅保存在服务器，不写入任何iPhone页面。
# V1.4 固定调用 DeepSeek 官方地址和 deepseek-flash，不需要配置 URL 或模型名。
AI_API_KEY=
# 必需：开启AI时要设置至少8位的访问码，避免公网滥用你的AI额度。
APP_ACCESS_CODE=

# V1.0 独立OCR访问码（至少8位，部署时自定义；与AI访问码不同）
OCR_ACCESS_CODE=

# V1.4 管理中心，仅服务端使用，任何值不得写进网页/公开仓库
# 至少16字符；部署到公网时务必使用独立强密码
ADMIN_PASSWORD=
# 用 cryptography.fernet.Fernet.generate_key() 生成，不与管理员密码相同
APP_SECRET_ENCRYPTION_KEY=
# 持久化磁盘/容器卷中的加密密钥文件路径
APP_SECRET_FILE=/srv/private/secrets.enc

# HTTPS 由 Nginx/Caddy 等反向代理终止时，填写代理连接到本容器的 IP 或 CIDR。
# 仅填写你实际控制的代理地址；直接部署且无反向代理时保持 127.0.0.1。
FORWARDED_ALLOW_IPS=127.0.0.1
